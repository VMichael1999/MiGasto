<?xml version="1.0" encoding="utf-8"?>
<!--
  MiGasto no usa la copia automática de Android (Google Drive) ni la transferencia automática
  entre teléfonos: la base está cifrada con una clave que vive en el almacén seguro de ESTE
  teléfono y no viaja, así que una copia restaurada en otro no se podría abrir. Los datos solo
  salen si el usuario crea un respaldo cifrado desde Ajustes.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
