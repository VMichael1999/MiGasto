<?xml version="1.0" encoding="utf-8"?>
<!-- «Resumen del mes» chico (2 × 2): anillo arriba y el saldo anclado abajo, como en la maqueta.
     Los textos son de ejemplo para la galería; HomeWidgets.kt los reemplaza. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_balance"
    android:clipToOutline="true">

    <ImageView
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-70dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_bg_glow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/ring_box"
                android:layout_width="46dp"
                android:layout_height="46dp">

                <ImageView
                    android:id="@+id/ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_ring_preview" />

                <TextView
                    android:id="@+id/ring_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:text="68%"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:text="NOV"
                android:textColor="@color/widget_white_72"
                android:textSize="11sp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/refresh"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ic_refresh"
                android:visibility="gone" />

            <TextView
                android:id="@+id/caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Disponible"
                android:textColor="@color/widget_white_82"
                android:textSize="12.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/balance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:autoSizeMaxTextSize="27sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:text="S/ 1,250.00"
            android:textColor="#FFFFFFFF"
            android:textSize="27sp" />
    </LinearLayout>
</FrameLayout>
