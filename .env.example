# Copia este archivo a .env y completa tus valores. No subas .env al repositorio.
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=

# Firebase: los valores salen de google-services.json (Android) y GoogleService-Info.plist (iPhone).
# Sin estos valores la app funciona igual, solo como invitado.
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=
# Clientes de Google Sign-In: web (Android) e iOS (iPhone), y el esquema de retorno de iPhone
# (REVERSED_CLIENT_ID del plist).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_REVERSED_CLIENT_ID=
